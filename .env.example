# Copy to .env (gitignored) and fill in. Never commit the real file.
#
# The credential-free path -- `forecast-spine acquire`, the fixture demo and
# the whole test suite -- needs none of this. Only `forecast-spine backfill`,
# which reads archived vintages older than the public MIS listing's ~7-day
# retention, requires credentials.
#
# Both are required. The subscription key alone returns
#   401 {"message": "Unauthorized. Access token is missing or invalid."}
# on every endpoint; the account login is what mints the bearer token.

# From https://apiexplorer.ercot.com/ -> your subscription -> Primary key
ERCOT_SUBSCRIPTION_KEY=

# Your ercot.com account, the one you sign in to the API Explorer with.
ERCOT_USERNAME=
ERCOT_PASSWORD=
